{
  "name": "neon-lite",
  "version": "0.2.0",
  "type": "module",
  "description": "A lightweight local Neon-compatible Postgres development server powered by PGlite",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "neon-lite": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@hono/node-server": "^1.13.8",
    "better-auth": "^1.2.12",
    "better-sqlite3": "^12.5.0",
    "hono": "^4.7.2",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
